# Leave empty in dev (Vite proxies /api and /socket.io to localhost:5000).
# On Vercel, set it to the public URL of the API, without a trailing slash:
# VITE_API_URL=https://learnsphere-api.onrender.com
VITE_API_URL=
# Only for CloudFront signed cookies: the parent domain shared by the app/API and the CDN hostname
VITE_CDN_COOKIE_DOMAIN=
