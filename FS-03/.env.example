# Copy to .env (never commit .env). docker compose reads it automatically.

# Local containers are used when these are left out.
# MongoDB Atlas: use the "Drivers" connection string and put the database name before the "?".
# MONGO_URI=mongodb+srv://learnsphere_user:<password>@<cluster>.mongodb.net/learnsphere?retryWrites=true&w=majority
# REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MEDIA_SIGNING_SECRET=

# Razorpay test mode (Dashboard > Test Mode > Account & Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# seed demo data when the database is empty
SEED_DEMO=true
