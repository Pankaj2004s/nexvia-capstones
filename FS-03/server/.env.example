PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
MONGO_URI=mongodb://127.0.0.1:27017/learnsphere
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
MEDIA_SIGNING_SECRET=change-me-media
# storage: local | s3
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# CloudFront signed delivery (optional; falls back to signed local URLs)
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
# Razorpay test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
INSTRUCTOR_SHARE=0.8
RUN_WORKER_INLINE=true
# seed an empty database once at boot and rebuild the demo video if its files are gone
SEED_DEMO=false
